{
  "name": "ai-clean-paste",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first clipboard cleanup for AI responses.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "studio:dev": "vite --config studio-ui/vite.config.ts",
    "studio:build": "vite build --config studio-ui/vite.config.ts",
    "studio:preview": "vite preview --config studio-ui/vite.config.ts --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && tsc --noEmit -p studio-ui/tsconfig.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
